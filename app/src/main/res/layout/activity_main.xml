<?xml version="1.0" encoding="utf-8"?>
<!-- Stage C: scrolling content on top, message bar fixed at the bottom (window uses adjustResize). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Pairing card. Texts come from PairingScreen/PairingTexts; the code's contentDescription
             ("Código 4 8 2 9 1 3") is set from MainActivity because it changes with every request.
             Stroke and dot colours follow the state's tone (PairingTones); the dot is decorative. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_pairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/itg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/itg_outline"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View android:id="@+id/status_dot" android:layout_width="10dp" android:layout_height="10dp"
                        android:layout_marginEnd="10dp" android:background="@drawable/status_dot"
                        android:importantForAccessibility="no" android:visibility="gone"/>
                    <TextView android:id="@+id/tv_pairing_title" android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
                        android:accessibilityLiveRegion="polite" android:visibility="gone"/>
                </LinearLayout>

                <TextView android:id="@+id/tv_pairing_code" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center" android:textSize="32sp"
                    android:typeface="monospace" android:textIsSelectable="false"
                    android:textColor="@color/itg_text_primary" android:letterSpacing="0.15"
                    android:importantForAccessibility="yes" android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"/>
                <TextView android:id="@+id/tv_pairing" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"/>
                <TextView android:id="@+id/tv_pairing_note" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:visibility="gone"/>
                <Button android:id="@+id/btn_pair" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_backend_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/itg_text_secondary"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_backend_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/backend_url_hint"
            android:textSize="14sp"
            android:inputType="textUri"
            android:layout_marginBottom="4dp"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_api_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_token_hint"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_audio_mode"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_button_start"
            android:layout_marginTop="8dp"/>

        <!-- Demo lentes: voice through Bluetooth glasses. Off by default. -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_glasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/glasses_switch"
            android:layout_marginTop="8dp"/>

        <!-- Background voice: a microphone foreground service with a notification. Off by default. -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/background_switch"
            android:layout_marginTop="8dp"/>

        <!-- Prueba de la patilla (fase A): only logs media buttons. Debug builds only; off by default. -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_media_probe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/media_probe_switch"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect"/>

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disconnect"
            android:layout_marginTop="8dp"
            android:enabled="false"/>

        <!-- Meta Wearables. Hidden in the phone variant (PhoneWearablesIntegration). -->
        <LinearLayout
            android:id="@+id/meta_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meta_mode_title"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/tv_meta_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meta_initializing"
                android:layout_marginTop="6dp"/>

            <Button
                android:id="@+id/btn_meta_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meta_register"
                android:enabled="false"/>

            <Button
                android:id="@+id/btn_meta_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meta_start_session"
                android:enabled="false"/>

            <Button
                android:id="@+id/btn_meta_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meta_stop_session"
                android:enabled="false"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:layout_marginTop="16dp"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_transcription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transcription_pending"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tv_ai_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_response_pending"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <!-- Pairing mode: welcome while Connected and nothing sent yet (ChatEmpty). Voice does not hide it. -->
        <LinearLayout
            android:id="@+id/chat_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/avatar_assistant"
                android:src="@drawable/ic_assistant"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/tv_chat_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/chat_empty_title"
                android:textColor="@color/itg_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_chat_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/chat_empty_subtitle"
                android:textColor="@color/itg_text_secondary"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Pairing mode: bubbles (ChatBubbles). Shared-token mode keeps tv_chat_output below, as before. -->
        <LinearLayout
            android:id="@+id/chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_chat_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/itg_text_primary"/>

    </LinearLayout>
</ScrollView>

    <!-- Pairing mode, Connected: the owner's chat history (ChatHistory). Hidden otherwise. -->
    <LinearLayout
        android:id="@+id/history_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/itg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_history"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/history_open"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_new_conversation"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/history_new"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/itg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/chat_placeholder"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/itg_text_primary"/>

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/send"/>
    </LinearLayout>
</LinearLayout>